# =============================================================================
# backend-core — variáveis de ambiente
# Copia este ficheiro para .env e preenche os valores marcados com TO_DEFINE.
# Todas as variáveis são lidas via Pydantic BaseSettings em app/config.py.
# =============================================================================


# -----------------------------------------------------------------------------
# AUTENTICAÇÃO / JWT
# -----------------------------------------------------------------------------

# Chave secreta usada para assinar tokens JWT. Obrigatória em produção.
SECRET_KEY=TO_DEFINE

# Validade do access token em minutos (default: 1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Algoritmo JWT. Não precisa de estar no .env — default HS256 no código.
# ALGORITHM=HS256


# -----------------------------------------------------------------------------
# BASE DE DADOS
# -----------------------------------------------------------------------------

# URL SQLAlchemy do SQLite. Em Railway usar caminho relativo: sqlite:///./app/core.db
DATABASE_URL=sqlite:///./core.db


# -----------------------------------------------------------------------------
# WHATSAPP / UAZAPI
# -----------------------------------------------------------------------------

# Chave de encriptação Fernet para cifrar tokens de instâncias WhatsApp em base de dados.
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_TOKEN_ENC_KEY=TO_DEFINE

# URL base da UazAPI.
UAZAPI_BASE_URL=https://free.uazapi.com

# Token de admin da UazAPI (usado para criar/gerir instâncias).
UAZAPI_ADMIN_TOKEN=TO_DEFINE

# Flag de stub: se true, simula o agente de IA em vez de chamar WhatsApp real.
# Manter false em produção.
CORE_WHATSAPP_STUB=false


# -----------------------------------------------------------------------------
# COMUNICAÇÃO INTER-SERVIÇOS
# -----------------------------------------------------------------------------

# Token partilhado com o backend-crm para chamadas server-to-server.
# Deve coincidir com CORE_SERVICE_TOKEN no backend-crm.
CORE_SERVICE_TOKEN=TO_DEFINE

# URL pública do CRM (backend-crm). Usada internamente para construir URLs de webhook.
# Ex. produção: https://crm-xxx.up.railway.app
CRM_PUBLIC_BASE_URL=TO_DEFINE

# URL do backend-executors (usado para delegar jobs de execução).
EXECUTORS_BASE_URL=http://localhost:8002


# -----------------------------------------------------------------------------
# PAINEL ADMIN
# -----------------------------------------------------------------------------

# Segredo de acesso ao painel SaaS admin (/admin/login).
ADMIN_SECRET=TO_DEFINE


# -----------------------------------------------------------------------------
# EMAIL / SMTP
# Usado para envio de emails de boas-vindas, reset de senha e notificações.
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=TO_DEFINE
# Remetente dos emails (ex: "Digital Pro <noreply@danielfranca.pt>")
SMTP_FROM=TO_DEFINE
SMTP_TLS=true

# URL do frontend-crm incluída nos links de email (reset de senha, boas-vindas).
# Ex. produção: https://crmapp.danielfranca.pt
CRM_FRONTEND_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# GOOGLE CALENDAR (OAuth2)
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=TO_DEFINE
GOOGLE_CLIENT_SECRET=TO_DEFINE
# URI de callback OAuth. Em produção substituir pelo URL público do backend-core.
# Ex: https://core-xxx.up.railway.app/auth/google/calendar/callback
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/calendar/callback


# -----------------------------------------------------------------------------
# GOOGLE MAPS
# Usado pelo endpoint proxy de Maps (agent-local delega aqui).
# -----------------------------------------------------------------------------

GOOGLE_MAPS_API_KEY=TO_DEFINE


# -----------------------------------------------------------------------------
# KIWIFY (pagamentos)
# -----------------------------------------------------------------------------

# Segredo para validar webhooks de pagamento do Kiwify.
KIWIFY_WEBHOOK_SECRET=TO_DEFINE

# ID do produto CRM no Kiwify (usado para associar pagamentos a planos).
KIWIFY_PRODUCT_ID=TO_DEFINE


# =============================================================================
# VARIÁVEIS NÃO UTILIZADAS (presentes no .env mas não lidas pelo código)
# Não pertencem ao backend-core — podem ser removidas com segurança.
# =============================================================================

# BACKEND_URL — não está em app/config.py; pertence ao agent-local
# AGENT_ID — idem, pertence ao agent-local
# AGENT_TOKEN — idem, pertence ao agent-local
# AGENT_USER_ID — idem, pertence ao agent-local
# JOB_TYPES — não está em app/config.py; pertence ao backend-executors
