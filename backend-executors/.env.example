# =============================================================================
# backend-executors — variáveis de ambiente
# Copia este ficheiro para .env e preenche os valores marcados com TO_DEFINE.
# Todas as variáveis são lidas via Pydantic BaseSettings em app/core/config.py.
# =============================================================================


# -----------------------------------------------------------------------------
# AMBIENTE
# -----------------------------------------------------------------------------

# Ambiente de execução. Afecta logging e comportamentos de debug.
ENV=dev

# Nível de log (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# COMUNICAÇÃO INTER-SERVIÇOS
# -----------------------------------------------------------------------------

# URL do backend-crm. Usada pelo worker para buscar jobs e reportar resultados.
CRM_API_BASE=http://localhost:8000

# URL do backend-core. Usada para validar tokens e obter dados de instâncias.
CORE_API_BASE=http://localhost:8001

# Token de autenticação nas chamadas ao backend-crm (rotas /executor e /playground).
# Deve coincidir com CRM_SERVICE_TOKEN no backend-crm.
CRM_SERVICE_TOKEN=TO_DEFINE

# Token de autenticação nas chamadas ao backend-core.
# Deve coincidir com CORE_SERVICE_TOKEN no backend-core.
CORE_SERVICE_TOKEN=TO_DEFINE


# -----------------------------------------------------------------------------
# LLM / IA
# Usado pelo meta_prompter e playground_internal para chamadas ao modelo de linguagem.
# -----------------------------------------------------------------------------

# URL base da API do LLM.
LLM_API_BASE=https://api.openai.com/v1

# Chave da API do LLM (OpenAI ou compatível).
LLM_API_KEY=TO_DEFINE

# Modelo a usar nas chamadas LLM.
LLM_MODEL=gpt-4o-mini

# Timeout em segundos para chamadas ao LLM.
LLM_TIMEOUT_SECONDS=20


# -----------------------------------------------------------------------------
# LLM / OPENROUTER
# Provedor alternativo à OpenAI, selecionável por usuário no AI Profile
# (campo llm_provider). Chave única do sistema, não é BYOK por usuário.
# -----------------------------------------------------------------------------

# URL base da API do OpenRouter (formato Chat Completions, OpenAI-compatible).
OPENROUTER_API_BASE=https://openrouter.ai/api/v1/chat/completions

# Chave da API do OpenRouter.
OPENROUTER_API_KEY=TO_DEFINE


# -----------------------------------------------------------------------------
# WORKER WHATSAPP
# -----------------------------------------------------------------------------

# Tipos de job que o worker processa, separados por vírgula.
# Default do código se não definido:
#   whatsapp.inbound.n8n,whatsapp.followup.tick,whatsapp.followup.pregenerate,whatsapp.appointment.reminder
# Só definir se quiseres restringir ou alterar os tipos processados por esta instância.
# WHATSAPP_WORKER_TYPES=whatsapp.inbound.n8n,whatsapp.followup.tick


# -----------------------------------------------------------------------------
# FLAGS
# -----------------------------------------------------------------------------

# Fallback heurístico de qualificação. 0 = desactivado, 1 = activado.
QUALIFICATION_HEURISTIC_FALLBACK=0


# =============================================================================
# VARIÁVEIS APENAS PARA SCRIPTS DE TESTE (não são lidas em produção)
# Presentes em scripts/ — não precisam de estar no .env de produção.
# =============================================================================

# CHAOS_SCENARIO, MAX_RUNTIME_SECONDS, MAX_ATTEMPTS_WAIT → scripts/test_5b56_chaos.py
# TEST_INSTANCE_ID, TEST_FROM, TEST_MESSAGE, TEST_MESSAGE_ID → scripts de teste
# CRM_BEARER_TOKEN → scripts/test_scenario_a_stub.py
