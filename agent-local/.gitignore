# ============================
# Agent Local — Git Ignore
# ============================

# Environment
.env
*.env
!*.env.example
.env.agent1
.env.agent2

# Python
__pycache__/
*.pyc

# Virtual environments
.venv/
venv/
*/.venv/
*/venv/

# Logs
*.log
agent.log

# Chrome user data directory (Selenium profile)
chrome-profile/
chrome_profile/
chrome_profiles/
.chrome-profile/
agent-local/chrome-profile/
agent-local/chrome_profile/

# WebDriver binaries
chromedriver
chromedriver.exe
geckodriver
geckodriver.exe
*webdriver*
*.bin

# Cache and temp
tmp/
temp/
*.tmp

# PyInstaller build output (agent-local.spec e' versionado, isto nao)
build/
dist/

# Inno Setup build output (agent-local-installer.iss e' versionado, isto nao)
installer_output/

# OS files
.DS_Store
Thumbs.db

# SQLite local testing (if ever created)
*.db

# Editor directories
.vscode/
.idea/


