# Backend FastAPI usado pelo agente local (CRM)
BACKEND_URL=http://localhost:8010

# Identificação/autenticação do agente
# Copie estes valores do endpoint de provisionamento do CRM (/api/agents/provision)
AGENT_ID=local-agent
AGENT_TOKEN=change-me

# Tipos de job que este agente irá processar
JOB_TYPES=whatsapp.send.local,maps.search.local,maps.enrich.local

# Intervalos de polling (segundos)
POLL_INTERVAL=5
IDLE_INTERVAL=15

# Configurações do Chrome/Selenium
CHROME_USER_DATA=${HOME}/.agent-local/chrome-profile
CHROME_HEADLESS=0
# CHROME_BINARY pode ser definido se o Chrome não estiver no PATH
CHROME_BINARY=

# Caminho do arquivo de log
AGENT_LOG=./agent.log
