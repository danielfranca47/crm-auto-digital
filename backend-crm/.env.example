# =============================================================================
# backend-crm — variáveis de ambiente
# Copia este ficheiro para .env e preenche os valores marcados com TO_DEFINE.
# =============================================================================


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Nível do root logger (setup_logging em logging_setup.py, chamado no arranque
# do app.py). Sem isto, logger.info(...) fica invisível — Python usa o
# last-resort handler (só WARNING+) quando nenhum handler é configurado.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# BACKENDS (server-to-server)
# -----------------------------------------------------------------------------

# URL do backend-core. Obrigatório — sem isto nenhum utilizador consegue autenticar.
CORE_API_BASE=http://localhost:8001

# Token partilhado entre backend-crm e backend-core para chamadas internas.
# Deve coincidir com CORE_SERVICE_TOKEN no backend-core.
CORE_SERVICE_TOKEN=TO_DEFINE

# Token que o backend-executors usa para chamar rotas internas do CRM (/executor, /playground).
CRM_SERVICE_TOKEN=TO_DEFINE

# URL pública do CRM (este backend). Usada para construir URLs de webhook enviadas à UazAPI.
# Ex. produção: https://api.danielfranca.pt  ou  https://crm-xxx.up.railway.app
CRM_PUBLIC_BASE_URL=http://localhost:8000

# URL do backend-executors. Usada pelo playground e pelo knowledge base para delegar jobs.
EXECUTORS_BASE_URL=http://localhost:8002


# -----------------------------------------------------------------------------
# WHATSAPP / WEBHOOKS
# -----------------------------------------------------------------------------

# Segredo para validar a assinatura dos webhooks inbound da UazAPI.
# Deve coincidir com o configurado na UazAPI.
CRM_WEBHOOK_SECRET=TO_DEFINE

# URL base da UazAPI. Usada para download de áudio de mensagens recebidas.
UAZAPI_BASE_URL=https://free.uazapi.com

# Efí Bank — API de Cobranças (assinaturas recorrentes)
# Painel Efí > API > Criar aplicação > habilitar escopo "Cobranças"
EFI_CLIENT_ID=TO_DEFINE
EFI_CLIENT_SECRET=TO_DEFINE
# true = ambiente sandbox/homologação, false = produção
EFI_SANDBOX=true

# IDs dos planos criados na Efí (POST /v1/plan) — um por oferta comercial.
# Diferem entre sandbox e produção; recriar e atualizar ao ir para produção.
EFI_PLAN_ID_START=TO_DEFINE
EFI_PLAN_ID_GROWTH=TO_DEFINE
EFI_PLAN_ID_GROWTH_FUNDADOR=TO_DEFINE


# -----------------------------------------------------------------------------
# IA / OPENAI
# -----------------------------------------------------------------------------

# Chave da OpenAI. Usada pelo LLM principal, transcrição de áudio, prospecção,
# qualificação, playground e spy agent.
OPENAI_API_KEY=TO_DEFINE

# Modelo OpenAI usado na prospecção (default: gpt-3.5-turbo).
# Opcional — só definir se quiseres usar outro modelo.
# OPENAI_MODEL=gpt-3.5-turbo


# -----------------------------------------------------------------------------
# BASE DE DADOS
# -----------------------------------------------------------------------------

# Caminho do ficheiro SQLite do CRM. Usado por todos os serviços com get_connection().
# Local: pode deixar vazio/omitir — cai no padrão backend-crm/database/crm.db.
# Em Railway: apontar para o volume persistente montado no serviço (ex.: /data/crm.db).
# Um caminho relativo fica dentro do filesystem efémero do container e é apagado a
# cada deploy — só um caminho dentro do volume sobrevive.
CRM_DB_PATH=database/crm.db


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Origins permitidas para rotas privadas do CRM (frontend-crm).
# Separar por vírgula. Em produção: https://crmapp.danielfranca.pt
PRIVATE_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS_PRIVATE=true

# Origins permitidas para rotas públicas (website de marketing).
# Em produção: https://danielfranca.pt
PUBLIC_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
CORS_ALLOW_CREDENTIALS_PUBLIC=false

# APP_BASE_URL: usado apenas para extrair o domínio do cookie de sessão JWT.
APP_BASE_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# AUTENTICAÇÃO JWT (login MVP)
# -----------------------------------------------------------------------------

JWT_SECRET=TO_DEFINE
JWT_ALG=HS256
ACCESS_EXPIRE_MIN=120

# Credenciais do admin (login directo no painel admin).
ADMIN_EMAIL=admin@exemplo.pt
ADMIN_PASSWORD_HASH=TO_DEFINE


# -----------------------------------------------------------------------------
# EMAIL / SMTP
# Usado pelo formulário público do website para enviar emails de contacto.
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=TO_DEFINE
SMTP_PASS=TO_DEFINE
EMAIL_FROM=contacto@danielfranca.pt
EMAIL_TO=contacto@danielfranca.pt

# Token de autenticação do formulário público (rota POST /public/contact).
FORM_TOKEN=TO_DEFINE


# -----------------------------------------------------------------------------
# PROSPECÇÃO / SCRAPING (Google Maps + scraper de sites)
# -----------------------------------------------------------------------------

# API Key do Google Maps. Opcional — sem ela o scraper usa só Selenium.
GOOGLE_MAPS_API_KEY=

# Tuning do scraper de sites. Os defaults são adequados para a maioria dos casos.
REQUEST_TIMEOUT=12
REQUEST_DELAY=1.0
MAX_PAGES_PER_SITE=6
MAX_SCROLL_ATTEMPTS=8

# User-Agent do scraper. Deixar vazio usa o default do código.
USER_AGENT=


# =============================================================================
# VARIÁVEIS NÃO UTILIZADAS (presentes no .env mas não lidas pelo código)
# Mantidas aqui para referência — podem ser removidas com segurança.
# =============================================================================

# USE_LEGACY_WHATSAPP — não lida em nenhum ficheiro .py
# USE_LEGACY_SEARCH_SELENIUM — não lida em nenhum ficheiro .py
# FRONTEND_ORIGINS — substituída por PRIVATE_ORIGINS + PUBLIC_ORIGINS
# CORS_ALLOW_CREDENTIALS — versão genérica substituída pelas duas específicas acima
# CORS_ORIGINS — compat antiga, não lida
# DATABASE_URL — o backend-crm usa sqlite3 raw, não SQLAlchemy; esta variável não tem efeito
# CSRF_COOKIE_NAME — não lida em nenhum ficheiro .py
# SMTP_FROM — não lida; o código usa EMAIL_FROM para o remetente
# PAIR_CODE_TTL_SECONDS — não lida em nenhum ficheiro .py
# AGENT_POLL_INTERVAL — não lida em nenhum ficheiro .py
# JOB_TYPES — não lida em nenhum ficheiro .py
