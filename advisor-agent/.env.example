# Copiar para .env e preencher os valores
# Não é necessária chave de API — o advisor usa o Claude Code CLI (claude --print)
# com as credenciais da tua conta Claude já autenticada.

# Opcional: caminho para os históricos do Claude Code
# (por defeito aponta para o caminho do projecto nesta máquina)
TRANSCRIPTS_DIR=C:\Users\Daniel França\.claude\projects\c--crm-auto-digital

# Opcional: caminho raiz do projecto CRM
PROJECT_DIR=c:\crm-auto-digital

# Hora da análise diária automática (formato HH:MM, 24h)
DAILY_ANALYSIS_TIME=08:00

# Porta do servidor
PORT=8005
